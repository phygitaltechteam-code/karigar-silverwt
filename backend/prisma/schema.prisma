// Payments to a karigar (Karigar page ledger). DEBIT = paid to karigar, CREDIT = taken back/adjusted.
model KarigarPayment {
  id        String   @id @default(uuid())
  adminId   String
  karigarId String
  karigar   karigar  @relation(fields: [karigarId], references: [id], onDelete: Cascade)
  amount    Float
  type      String   @default("DEBIT")
  account   String?
  job       String?
  stage     String?
  stageId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([adminId, karigarId])
}

// ---------------------------------------------------------------------------
// Billing (Create Bill / Bill list / Bill edit). DRAFT bills do not touch stock
// or balances; BILL (completed) deducts stock and updates the client's balance.
// ---------------------------------------------------------------------------
enum ReceiptType {
  DRAFT
  BILL
}

model receipt {
  id              String        @id @default(uuid())
  adminId         String
  clientID        String
  client          client        @relation(fields: [clientID], references: [id])
  billNumber      String
  receiptDate     DateTime?
  type            ReceiptType   @default(BILL)
  totalWeight     Float         @default(0)
  customerWeight  Float         @default(0)
  // Advance rows (item, purity, gross, fine) the customer gave; customerWeight is their fine total
  advanceItems    Json?
  remainingWeight Float         @default(0)
  dueBalance      Float?
  totalBill       Float?
  // Change applied to the client balance when completed (reversed on edit/delete)
  balanceDelta    Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  receiptItems    receiptItem[]

  @@unique([adminId, billNumber])
  @@index([adminId, createdAt])
}

model receiptItem {
  id          String   @id @default(uuid())
  receiptID   String
  receipt     receipt  @relation(fields: [receiptID], references: [id], onDelete: Cascade)
  itemID      String
  item        Item     @relation(fields: [itemID], references: [id])
  sizeID      String?
  size        size?    @relation(fields: [sizeID], references: [id])
  purity      Float    @default(0)
  grossWeight Float    @default(0)
  srp         Float    @default(0)
  fineWeight  Float    @default(0)
  laborRate   Float    @default(0)
  /// GRAM = labour charged in fine grams (added to the bill), AMOUNT = labour in rupees
  laborType   String   @default("GRAM")
  design      String?
  stamp       String?
  productCode String?
  createdAt   DateTime @default(now())
}

/// Loss alert rules for the chain stages (Company ... Vibrator); one table, keyed by process
model processAlert {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  process    String
  grossWt    Float
  lossWt     Float    @default(0)
  adjsutment Float    @default(0)
  purity     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([adminId, process])
}
