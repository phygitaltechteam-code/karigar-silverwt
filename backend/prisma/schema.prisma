  adjsutment Float    @default(0)
  purity     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([adminId])
}

model kundaAlert {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  grossWt    Float
  lossWt     Float    @default(0)
  adjsutment Float    @default(0)
  purity     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([adminId])
}

model jointAlert {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  grossWt    Float
  lossWt     Float    @default(0)
  adjsutment Float    @default(0)
  purity     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([adminId])
}

model cuttingAlert {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  grossWt    Float
  lossWt     Float    @default(0)
  adjsutment Float    @default(0)
  purity     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

