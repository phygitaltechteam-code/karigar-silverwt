model solderingAlert {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  grossWt    Float
  lossWt     Float    @default(0)
  adjsutment Float    @default(0)
  purity     Float
